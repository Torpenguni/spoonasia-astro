---
import { languages, type Lang } from '../i18n/ui';
import { getAlternates, getLangFromUrl, getRoutePath, localizePath, localizedHref, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = getRoutePath(Astro.url.pathname);

const primaryItems = [
  { label: t('nav.news'),      href: '/market-watch' },
  { label: t('nav.deals'),     href: '/deals' },
  { label: t('nav.analysis'),  href: '/analysis' },
  { label: t('nav.operators'), href: '/operators' },
  { label: t('nav.supplier'),  href: '/supplier-intel' },
  { label: t('nav.events'),    href: '/events' },
  { label: t('nav.locations'), href: '/locations' },
  { label: t('nav.videos'),    href: '/videos' },
];

const today = new Date().toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
  timeZone: 'Asia/Bangkok',
});

// Switcher: go to the same page in the other language when it exists,
// otherwise to that language's front page.
const alternates = getAlternates(Astro.url.pathname);
const switchTargets = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  label: languages[code],
  href: alternates.find((a) => a.lang === code)?.path ?? localizePath('/', code),
  current: code === lang,
}));
---

<header class="band">
  <div class="container">
    <div class="masthead-inner">
      <button class="hamburger" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>

      <div class="masthead-left">
        <span class="masthead-date">{today} · {t('site.city')}</span>
      </div>

      <a href={localizedHref('/', lang)} class="masthead-logo" aria-label={t('site.home')}>
        <span class="logo-bold">Spoon</span><span class="logo-light">Asia</span><span class="logo-dot" aria-hidden="true"></span>
      </a>

      <div class="masthead-right">
        <nav class="lang-switch" aria-label={t('nav.language')}>
          {switchTargets.map((target) => (
            target.current
              ? <span class="lang-opt current" lang={target.code} aria-current="true">{target.label}</span>
              : <a href={target.href} class="lang-opt" lang={target.code} hreflang={target.code}>{target.label}</a>
          ))}
        </nav>
        <button class="mast-link search-btn" aria-label={t('nav.search')}>{t('nav.search')}</button>
        <a href={localizedHref('/newsletter', lang)} class="mast-link">{t('nav.newsletters')}</a>
        <a href={localizedHref('/penguin-x', lang)} class="subscribe-btn">{t('nav.subscribe')}</a>
      </div>
    </div>
  </div>
</header>

<nav class="band close" id="mobile-nav">
  <div class="container">
    <div class="primary-nav-inner">
      {primaryItems.map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href + '/');
        return (
          <a href={localizedHref(item.href, lang)} class={`primary-nav-link ${isActive ? 'active' : ''}`}>
            {item.label}
          </a>
        );
      })}
      <a href={localizedHref('/penguin-x', lang)} class={`primary-nav-link cta ${currentPath.startsWith('/penguin-x') ? 'active' : ''}`}>
        Penguin X ↗
      </a>
    </div>
  </div>
</nav>

<style>
  .masthead-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    padding: 18px 0 16px;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px 8px 8px 0;
  }
  .hamburger span { display: block; width: 18px; height: 1px; background: var(--ink); }

  .masthead-left { display: flex; align-items: center; }

  .masthead-date {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  /* 42px/800 down to 26px/700 — the masthead stops competing with the
     lead story, which is the whole point of the redesign. */
  .masthead-logo {
    font-family: var(--font-sans);
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
  }
  .logo-bold { font-weight: 800; }
  .logo-light { font-weight: 400; }
  .logo-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    background: var(--accent);
    margin-left: 4px;
    /* An empty inline-block's baseline is its bottom edge, so with the
       flex container aligning baselines the square sits exactly on the
       type's baseline. */
    align-self: baseline;
  }
  .masthead-logo:hover { color: var(--accent); }

  .masthead-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0;
  }

  .mast-link {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 0 14px;
    border: none;
    border-right: 1px solid var(--rule);
    background: transparent;
    cursor: pointer;
    line-height: 1.4;
  }
  .mast-link:hover { color: var(--accent); }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px 0 0;
    border-right: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    line-height: 1.4;
    white-space: nowrap;
  }
  .lang-opt { color: var(--ink-mute); }
  .lang-opt + .lang-opt::before {
    content: '/';
    margin-right: 6px;
    color: var(--rule-hard);
  }
  a.lang-opt:hover { color: var(--accent); }
  .lang-opt.current { color: var(--ink); font-weight: 500; }

  .subscribe-btn {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 8px 14px;
    margin-left: 14px;
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .subscribe-btn:hover { background: var(--accent); color: var(--paper); }

  /* Each section is its own ruled cell, like a row on a terminal. */
  .primary-nav-inner {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .primary-nav-inner::-webkit-scrollbar { display: none; }

  .primary-nav-link {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-soft);
    padding: 12px 15px;
    white-space: nowrap;
    letter-spacing: 0.005em;
    position: relative;
    border-right: 1px solid var(--rule);
  }
  .primary-nav-link:first-child { padding-left: 0; }
  .primary-nav-link:hover { color: var(--ink); }
  .primary-nav-link.active { color: var(--ink); font-weight: 600; }
  .primary-nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 15px;
    right: 15px;
    height: 2px;
    background: var(--accent);
    z-index: 1;
  }
  .primary-nav-link.active:first-child::after { left: 0; }
  .primary-nav-link.cta {
    margin-left: auto;
    color: var(--accent);
    font-weight: 600;
    border-right: none;
    border-left: 1px solid var(--rule);
    padding-right: 0;
  }

  @media (max-width: 768px) {
    .masthead-inner {
      grid-template-columns: auto 1fr auto;
      padding: 14px 0 12px;
    }
    .hamburger { display: flex; }
    .masthead-left { display: none; }
    .masthead-logo { font-size: 35px; }
    .mast-link { display: none; }
    /* Phones: only the language you can switch to, so the masthead fits. */
    .masthead-inner { gap: 10px; }
    .lang-switch { padding-right: 8px; margin-right: 8px; }
    .lang-opt.current { display: none; }
    .lang-opt + .lang-opt::before { content: none; }
    .subscribe-btn { margin-left: 0; font-size: 9px; padding: 7px 11px; }
    .primary-nav-link { font-size: 12px; padding: 11px 12px; }
  }
</style>
