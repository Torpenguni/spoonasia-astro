---
// The Dispatch signup. Same list, same form as the footer.
---
<div class="mod signup">
  <div class="signup-row">
    <div class="signup-thumb" aria-hidden="true"></div>
    <div>
      <h3>Get The Dispatch</h3>
      <p>F&B intelligence on Asia, every Sunday. Unit economics, neighborhood alpha, and the gaps in pitch decks.</p>
    </div>
  </div>
  <form class="signup-form" onsubmit="event.preventDefault()">
    <input type="email" placeholder="your@email.com" aria-label="Email address" required />
    <button type="submit">Sign up</button>
  </form>
</div>
