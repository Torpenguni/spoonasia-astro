---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const videoEntries = await getCollection('videos', ({ data }) => !data.draft);
videoEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const videos = videoEntries.slice(0, 3).map((v) => ({
  number: v.data.episode,
  title: v.data.title,
  duration: v.data.duration,
  views: v.data.views,
  slug: v.slug,
}));

const featuredTout = {
  tag: 'Unit Economics',
  headline: "Why foreign coffee chains keep failing in Thailand",
  dek: "Three international chains entered in 2023. Two are closing outlets in 2025. The difference wasn't the coffee — it was the rent escalator, the staff turnover, and the math no broker shows you.",
  author: 'SpoonAsia Desk',
  date: '13 May 2026',
  readTime: '12 min read',
  slug: 'why-foreign-coffee-chains-fail-thailand',
};

const fascinatingReads = [
  { tag: 'Neighborhood', headline: "Why Ari became Bangkok's most underrated F&B zone", slug: 'ari-bangkok-fb-zone' },
  { tag: 'Market Entry', headline: "The hidden costs no Thai broker will tell you about", slug: 'hidden-costs-thai-market-entry' },
  { tag: 'Operator', headline: "Penguin Eat Shabu: anatomy of a 40-outlet rollout", slug: 'penguin-eat-shabu-rollout' },
];

const quickLinks = [
  'Thai REIT yields are bottoming — and F&B operators should care',
  'Why Japanese chains are quietly winning Bangkok malls',
  'The shrinking margin on bubble tea, in one chart',
  'Sukhumvit 31 is the new 49. Here\'s why',
  '7-Eleven\'s F&B push reshapes supplier dynamics',
];

const floodArticles = [
  {
    tag: 'Markets',
    headline: 'Bangkok mall F&B vacancy hits 7-year high as anchor tenants exit',
    dek: 'EmQuartier, ICONSIAM, and Central Embassy all report double-digit F&B turnover.',
    date: '13 May 2026',
    slug: 'bangkok-mall-fb-vacancy',
  },
  {
    tag: 'Operators',
    headline: 'After Inflation: how three Bangkok chains rewrote their menus to survive',
    dek: 'A close read of menu engineering, portion calibration, and price-tier strategy.',
    date: '12 May 2026',
    slug: 'menu-engineering-bangkok',
  },
  {
    tag: 'Suppliers',
    headline: 'The hidden duopoly behind Thailand\'s coffee bean trade',
    dek: 'Two importers control 78% of specialty bean flow into Bangkok cafés.',
    date: '11 May 2026',
    slug: 'coffee-duopoly-thailand',
  },
  {
    tag: 'Investment',
    headline: 'Why Singaporean family offices keep funding Thai F&B — even when it loses money',
    dek: 'Lifestyle capital, brand portfolios, and the ASEAN halo trade.',
    date: '10 May 2026',
    slug: 'singapore-family-office-thai-fb',
  },
  {
    tag: 'Neighborhood',
    headline: 'Phra Khanong is quietly becoming Bangkok\'s next F&B frontier',
    dek: 'Three signals: rents up 18%, BTS upgrades, and Gen Z creator clusters.',
    date: '09 May 2026',
    slug: 'phra-khanong-frontier',
  },
  {
    tag: 'Operators',
    headline: 'Thai cloud kitchens are pivoting hard — and most won\'t survive',
    dek: 'GrabFood data shows the order curve flattening for the first time since 2019.',
    date: '08 May 2026',
    slug: 'thai-cloud-kitchens-pivot',
  },
];

// The rank column carries real information, so each row names its desk.
const popularStories = [
  { headline: 'Why every Japanese ramen chain in Bangkok looks the same now', desk: 'Operators' },
  { headline: 'The unit economics of a 60-seat Sukhumvit izakaya', desk: 'Analysis' },
  { headline: 'How CentralWorld broke its own F&B floor plan', desk: 'Locations' },
  { headline: 'A field guide to Thai partner contracts (and the clauses that ruin foreigners)', desk: 'Market Entry' },
  { headline: 'The case for buying — not opening — your first Thai F&B outlet', desk: 'Deals' },
];

const greatRead = {
  tag: 'Investigation',
  headline: 'Bangkok rent is not a number — it is a story about who the city is becoming',
  dek: 'A five-month investigation into how landlords price retail F&B space across nine Bangkok neighborhoods. What we found rewrites the standard market-entry playbook.',
  author: 'SpoonAsia Editorial',
  date: '07 May 2026',
  readTime: '24 min read',
  slug: 'bangkok-rent-story',
};
---

<BaseLayout
  title="SpoonAsia — F&B Investment Intelligence for Asia"
  description="Decoding Thailand's F&B landscape for international investors, suppliers, and operators. Unit economics, neighborhood alpha, and the gaps in pitch decks."
>

  <!-- ===== Hero band: lead column and rail, split by a full-height rule ===== -->
  <div class="band close">
    <div class="container">
      <div class="cols hero">

        <div class="hero-lead">
          <article>
            <a href={`/analysis/${featuredTout.slug}`} class="hero-image-link">
              <div class="well hero-well" aria-hidden="true"></div>
            </a>
            <span class="kicker">{featuredTout.tag}</span>
            <h1 class="hero-headline">
              <a href={`/analysis/${featuredTout.slug}`}>{featuredTout.headline}</a>
            </h1>
            <p class="hero-dek">{featuredTout.dek}</p>
            <div class="meta">
              {featuredTout.author} · {featuredTout.date} · {featuredTout.readTime}
            </div>
          </article>

          <!-- The three related heads, divided the way a wire service sets them -->
          <div class="cols hero-sub">
            {fascinatingReads.map(item => (
              <a href={`/analysis/${item.slug}`}>
                <span class="kicker tight">{item.tag}</span>
                <h3 class="hero-sub-head">{item.headline}</h3>
              </a>
            ))}
          </div>
        </div>

        <aside class="hero-rail">
          <div class="rail-label">Quick Links</div>
          <ul class="rail-list">
            {quickLinks.map(link => (
              <li class="rail-item"><a href="#" class="rail-head">{link}</a></li>
            ))}
          </ul>
        </aside>

      </div>
    </div>
  </div>

  <!-- ===== Today's coverage: ruled on both axes ===== -->
  <section class="band">
    <div class="container">
      <div class="label-bar">
        <h2 class="section-tag">Today's Coverage</h2>
        <a href="/analysis" class="label-more">All coverage ↗</a>
      </div>
      <div class="band-body">
        <div class="flood-grid">
          {floodArticles.map(article => (
            <article class="flood-card">
              <a href={`/analysis/${article.slug}`} class="flood-image-link">
                <div class="well flood-well" aria-hidden="true"></div>
              </a>
              <span class="kicker">{article.tag}</span>
              <h3 class="flood-headline">
                <a href={`/analysis/${article.slug}`}>{article.headline}</a>
              </h3>
              <p class="flood-dek">{article.dek}</p>
              <div class="meta">{article.date}</div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Most read: a ranked table ===== -->
  <section class="band">
    <div class="container">
      <div class="label-bar">
        <h2 class="section-tag">Most Read This Week</h2>
      </div>
      <div class="band-body">
        <ol class="popular-list">
          {popularStories.map((story, i) => (
            <li class="popular-item">
              <span class="popular-num">{String(i + 1).padStart(2, '0')}</span>
              <a href="#" class="popular-headline">{story.headline}</a>
              <span class="popular-desk">{story.desk}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== The long read: the one place serif still earns its keep ===== -->
  <section class="band">
    <div class="container">
      <div class="label-bar">
        <h2 class="section-tag">The Long Read</h2>
      </div>
      <div class="band-body">
        <div class="cols longread">
          <div>
            <a href={`/analysis/${greatRead.slug}`}>
              <div class="well longread-well" aria-hidden="true"></div>
            </a>
          </div>
          <div>
            <span class="kicker">{greatRead.readTime} · {greatRead.tag}</span>
            <h3 class="longread-headline">
              <a href={`/analysis/${greatRead.slug}`}>{greatRead.headline}</a>
            </h3>
            <p class="longread-dek serif">{greatRead.dek}</p>
            <div class="meta">{greatRead.author} · {greatRead.date}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Videos: the footer's rule closes this one ===== -->
  <section>
    <div class="container">
      <div class="label-bar">
        <h2 class="section-tag">Videos</h2>
        <a href="/videos" class="label-more">All episodes ↗</a>
      </div>
      <div class="band-body">
        <div class="cols videos">
          {videos.map(video => (
            <a href={`/videos/${video.slug}`} class="video">
              <div class="well video-well" aria-hidden="true">
                <span class="video-play">▶</span>
                <span class="video-duration">{video.duration}</span>
              </div>
              <span class="kicker tight">Ep. {video.number} · {video.views} views</span>
              <h3 class="video-headline">{video.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- shared atoms ---------------------------------------- */
  .kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .kicker.tight { margin-bottom: 5px; }

  .meta {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-top: 12px;
    font-variant-numeric: tabular-nums;
  }

  .band-body { padding: 26px 0 34px; }

  /* ---- hero -------------------------------------------------- */
  .hero {
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
    align-items: stretch;
  }
  .hero-lead { padding: 30px 30px 0 0; }
  .hero-rail { padding: 30px 0 26px 28px; }

  .hero-image-link { display: block; margin-bottom: 20px; }
  .hero-well { aspect-ratio: 16 / 9; }

  .hero-headline {
    font-size: clamp(30px, 3.6vw, 44px);
    font-weight: 700;
    letter-spacing: -0.032em;
    line-height: 1.06;
  }

  .hero-dek {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 58ch;
    margin-top: 14px;
  }

  .hero-sub {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    margin-top: 26px;
    padding: 20px 0 26px;
  }
  .hero-sub > * { padding: 0 18px; }
  .hero-sub > *:first-child { padding-left: 0; }
  .hero-sub > *:last-child { padding-right: 0; }

  .hero-sub-head {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.25;
  }

  .rail-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-hard);
  }

  .rail-list { list-style: none; }

  .rail-item {
    padding: 13px 0;
    border-bottom: 1px solid var(--rule);
  }
  .rail-item:last-child { border-bottom: none; }

  .rail-head {
    display: block;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  /* ---- today's coverage -------------------------------------- */
  .flood-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .flood-card {
    padding: 26px 24px;
    border-left: 1px solid var(--rule);
    border-top: 1px solid var(--rule);
  }
  .flood-card:nth-child(3n + 1) { border-left: none; padding-left: 0; }
  .flood-card:nth-child(3n) { padding-right: 0; }
  .flood-card:nth-child(-n + 3) { border-top: none; padding-top: 0; }

  .flood-image-link { display: block; margin-bottom: 16px; }
  .flood-well { aspect-ratio: 3 / 2; }

  .flood-headline {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.2;
  }

  .flood-dek {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-top: 10px;
  }

  /* ---- most read --------------------------------------------- */
  .popular-list { list-style: none; }

  .popular-item {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .popular-item:last-child { border-bottom: none; }

  .popular-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-mute);
    font-variant-numeric: tabular-nums;
  }

  .popular-headline {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.017em;
    line-height: 1.3;
  }

  .popular-desk {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  /* ---- long read ---------------------------------------------- */
  .longread { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .longread > *:first-child { padding-right: 32px; }
  .longread > *:last-child { padding-left: 32px; }

  .longread-well { aspect-ratio: 4 / 3; }

  .longread-headline {
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .longread-dek {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin-top: 16px;
  }

  /* ---- videos -------------------------------------------------- */
  .videos { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .video-well {
    aspect-ratio: 16 / 9;
    margin-bottom: 14px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-play {
    width: 34px;
    height: 34px;
    border: 1px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: var(--ink);
  }

  .video-duration {
    position: absolute;
    right: 8px;
    bottom: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--ink);
    color: var(--paper);
    padding: 2px 6px;
    font-variant-numeric: tabular-nums;
  }

  .video-headline {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.25;
  }

  @media (max-width: 900px) {
    .hero-lead, .hero-rail { padding: 22px 0 !important; }
    .hero-sub { margin-top: 20px; }

    .flood-grid { grid-template-columns: 1fr; }
    .flood-card {
      border-left: none;
      border-top: 1px solid var(--rule);
      padding: 24px 0;
    }
    .flood-card:first-child { border-top: none; padding-top: 0; }

    .popular-item {
      grid-template-columns: 32px 1fr;
      gap: 10px;
    }
    .popular-desk { grid-column: 2; }

    .longread > *:first-child,
    .longread > *:last-child { padding: 22px 0 !important; }
  }
</style>
