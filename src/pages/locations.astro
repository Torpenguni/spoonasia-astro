---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionFront from '../components/SectionFront.astro';
import RailSignup from '../components/rail/RailSignup.astro';
import RailPromo from '../components/rail/RailPromo.astro';
import RailLatest from '../components/rail/RailLatest.astro';

// Layer 1 — zone dossiers. The atlas everything else refers back to.
// Photo licensing lives in public/images/locations/CREDITS.md — the credit
// line on each card satisfies the CC BY / BY-SA attribution requirement.
const watchlist = [
  { tag: 'Premium CBD', map: 'sukhumvit' as const, name: 'Sukhumvit — Asoke / Thonglor / Ekkamai', note: 'Rent runs $78–95/sqm. Premium-mall saturation. Foreign-chain flagship belt. Margin compression risk: high.', credit: 'Max221B · CC BY-SA 4.0', creditHref: 'https://commons.wikimedia.org/wiki/File:Bangkok_from_sukhumvit.jpg' },
  { tag: 'Creator Corridor', map: 'ari' as const, name: 'Ari', note: 'BTS Ari corridor. Independent-favored, low-rise zoning, creator-class footprint. Rent $42/sqm — rising fast.', credit: 'Phoebus 28 · CC0', creditHref: 'https://commons.wikimedia.org/wiki/File:Ari_Samphan_Noodles_Stall.jpg' },
  { tag: 'Frontier', map: 'phra-khanong' as const, name: 'Phra Khanong', note: 'Emerging F&B zone. Rents up 18% YoY. BTS upgrade Q4 2024. Window-of-entry open through 2026.', credit: 'Suikotei · CC BY-SA 4.0', creditHref: 'https://commons.wikimedia.org/wiki/File:Phra_Khanong_Station.jpg' },
  { tag: 'Heritage', map: 'charoenkrung' as const, name: 'Charoenkrung / Talad Noi', note: "Heritage-led, slow burn. Premium-independent only. Mall-tier formats don't survive here.", credit: 'Phoebus 28 · CC BY-SA 4.0', creditHref: 'https://commons.wikimedia.org/wiki/File:Talat_Noi_Street_Art.jpg' },
  { tag: 'Local-tier', map: 'ratchada' as const, name: 'Ratchada / Huai Khwang', note: 'Underwritten by night-market footfall. Resilient unit economics, lower ceiling.', credit: 'aotaro · CC BY 2.0', creditHref: 'https://commons.wikimedia.org/wiki/File:Train_Night_Market_Ratchada_(34144230042).jpg' },
  { tag: 'Mall-tier', map: 'mall-tier' as const, name: 'EmQuartier / ICONSIAM / Central Embassy', note: 'Premium mall F&B vacancy at 7-year high. Effective rent down 15–22% vs 2024. Leverage window open.', credit: 'Supanut Arunoprayote · CC BY 4.0', creditHref: 'https://commons.wikimedia.org/wiki/File:Iconsiam_at_Day_(III).jpg' },
];

// Layer 2 — the supply pipeline. Every mega-project and mixed-use launch
// that adds F&B floorplate, read for what it does to the zones around it —
// not the developer's press release. Full files live in
// src/data/properties.ts and render at /properties/<slug>.
import { properties } from '../data/properties';

// Layer 3 — infrastructure and momentum. The leading indicators of a rent
// curve, logged before the brokers reprice the corridor.
const signals = [
  {
    tag: 'Transit',
    name: 'MRT Orange Line (east section) — targeted 2027',
    note: 'Thailand Cultural Centre to Min Buri. The single biggest re-pricing event pending for Ramkhamhaeng and Bang Kapi — corridors still priced local-tier.',
  },
  {
    tag: 'Transit',
    name: 'Pink & Yellow monorails — ridership maturing',
    note: 'Two years in, transfer nodes (Lat Phrao, Samrong) show the compounding footfall. Mid-corridor stations still lag — node-adjacency matters more than line-adjacency.',
  },
  {
    tag: 'Corridor',
    name: 'Rama IV — from pass-through to destination',
    note: 'One Bangkok + Dusit Central Park + Samyan Mitrtown now anchor a continuous spine. Weekday spend is proven; the open question is whether weekends follow.',
  },
  {
    tag: 'Rail hub',
    name: 'Krung Thep Aphiwat (Bang Sue) — slow burn',
    note: 'Thailand’s largest station still under-indexes on retail spend. The surrounding plots are a land-bank story for now — early F&B entry here is patience capital.',
  },
  {
    tag: 'Zoning',
    name: 'Low-rise caps — the quiet moat',
    note: 'Where the city plan caps height (Ari and parts of Charoenkrung), supply cannot flood in behind a rent run. Zoning is the most durable protection an operator’s lease can sit behind.',
  },
];

const topics = watchlist.map((w) => ({ label: w.tag, count: 0 }));
---

<BaseLayout
  title="Locations — SpoonAsia"
  description="Bangkok F&B location intelligence — zone dossiers, the mega-project supply pipeline read through an operator's P&L, and the infrastructure signals that re-price a corridor."
>
  <SectionFront title="Locations" topics={topics}>

    <div class="notice">
      <div class="notice-label">In production</div>
      <p class="notice-text">
        Location is an investment decision, not a map. Three layers below:
        the zone dossiers, the supply pipeline read through an operator's
        P&L, and the infrastructure signals that re-price a corridor before
        the brokers do. Monthly reports launch Q3 2026 —
        subscribe to <a href="/newsletter">The Dispatch</a> for the first six zones.
      </p>
    </div>

    <div class="group-head">The zones</div>
    <div class="grid3">
      {watchlist.map((w) => (
        <article>
          <div class="zone-photo">
            <img src={`/images/locations/${w.map}.webp`} alt={w.name} width="960" height="640" loading="lazy" />
          </div>
          <a class="zone-credit" href={w.creditHref} target="_blank" rel="noopener noreferrer">Photo: {w.credit}</a>
          <span class="kicker">{w.tag}</span>
          <h3>{w.name}</h3>
          <p class="dek">{w.note}</p>
        </article>
      ))}
    </div>

    <div class="group-head">Supply watch — the pipeline</div>
    <p class="group-dek">
      Every project adding meaningful F&B floorplate, and what it does to the
      zones around it. Each opens the full property file.
    </p>
    <div class="grid3">
      {properties.map((p) => (
        <a href={`/properties/${p.slug}`} class="prop-card">
          <div class="prop-photo">
            <img src={p.image} alt={p.name} width="1600" height="900" loading="lazy" />
          </div>
          <span class="prop-status">{p.status}</span>
          <h3>{p.name} →</h3>
          <span class="prop-district">{p.district}</span>
          <p class="dek">{p.read}</p>
        </a>
      ))}
    </div>

    <div class="group-head">Signals — infrastructure &amp; momentum</div>
    <p class="group-dek">
      The leading indicators of a rent curve. Logged here first, folded into
      the zone dossiers as they play out.
    </p>
    <div class="watchlist">
      {signals.map((s) => (
        <article>
          <span class="kicker">{s.tag}</span>
          <h3>{s.name}</h3>
          <p class="dek">{s.note}</p>
        </article>
      ))}
    </div>

    <Fragment slot="rail">
      <RailSignup />
      <RailPromo section="locations" />
      <RailLatest />
    </Fragment>

  </SectionFront>
</BaseLayout>

<style>
  .group-head {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ink-soft);
    margin: 40px 0 4px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-hard, var(--ink));
  }

  .group-head:first-of-type { margin-top: 28px; }

  .zone-photo {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--paper-warm, var(--well));
    margin-bottom: 6px;
  }

  .zone-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .zone-credit {
    display: block;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    margin-bottom: 10px;
  }

  .zone-credit:hover { color: var(--ink-soft); }

  .group-dek {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 14px 0 6px;
    max-width: 560px;
  }

  .prop-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .prop-photo {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-warm, var(--well));
    margin-bottom: 12px;
  }

  .prop-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .prop-card:hover .prop-photo img { transform: scale(1.025); }

  .prop-status {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .prop-card h3 { transition: color 0.2s; }

  .prop-card:hover h3 { color: var(--accent); }

  .prop-district {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 4px;
  }
</style>
