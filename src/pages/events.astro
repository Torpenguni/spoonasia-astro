---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionFront from '../components/SectionFront.astro';
import RailSignup from '../components/rail/RailSignup.astro';
import RailPromo from '../components/rail/RailPromo.astro';

// Event pages, photo archives, and booking live on penguinx.co — this page
// is the SpoonAsia-side front for them. Adding an event = one entry here,
// its thumbnail in public/images/events/, and its page on the PenguinX site.
const PX = 'https://penguinx.co/events';

const owned = [
  { kind: 'Conference', name: 'TRC — Thailand Restaurant Conference', href: `${PX}/trc.html`, image: '/images/events/trc.webp', note: 'Multi-day, multi-track programming for owners and senior operators. The room where annual decisions get made.' },
  { kind: 'Expo', name: 'Restech', href: `${PX}/restech.html`, image: '/images/events/restech.webp', note: 'Restaurant tech and equipment expo — live demos, comparison, on-floor procurement.' },
  { kind: 'Expo', name: 'Damn Expo', href: `${PX}/damn-expo.html`, image: '/images/events/damn-expo.webp', note: 'Nightlife and craft-liquor home expo. Bar owners, distributors, beverage brands on one floor.' },
  { kind: 'Conference', name: 'CafCon', href: `${PX}/cafcon.html`, image: '/images/events/cafcon.webp', note: 'The café business conference — coffee shop owners, roasters, category suppliers, one playbook.' },
  { kind: 'Community', name: '#LongKaek', href: `${PX}/longkaek.html`, image: '/images/events/longkaek.webp', note: 'Founder-only peer dinners — competitors turning into trusted allies, by invitation.' },
];

const forBrands = [
  { kind: 'Conference', name: 'Thaifex Horec', href: `${PX}/thaifex-horec.html`, image: '/images/events/thaifex-horec.webp', note: 'Built the operator-focused conference inside Asia’s biggest food and hospitality trade show — from the speaker list up.' },
  { kind: 'Conference · Workshop', name: 'GSB', href: `${PX}/gsb.html`, image: '/images/events/gsb.webp', note: 'Conference and workshop programming for GSB.' },
  { kind: 'Conference · Workshop', name: 'SME D Bank', href: `${PX}/sme-d-bank.html`, image: '/images/events/sme-d-bank.webp', note: 'Conference and workshop programming for SME D Bank.' },
  { kind: 'Workshop', name: 'เงินให้ใจ', href: `${PX}/ngern-hai-jai.html`, image: '/images/events/ngern-hai-jai.webp', note: 'Workshop programming for เงินให้ใจ.' },
  { kind: 'Conference · Workshop', name: 'LINE', href: `${PX}/line.html`, image: '/images/events/line.webp', note: 'Conference and workshop programming for LINE.' },
  { kind: 'Conference', name: 'RMBA Forum', href: `${PX}/rmba-forum.html`, image: '/images/events/rmba-forum.webp', note: 'Conference programming for the Restaurant MBA Forum.' },
  { kind: 'Conference', name: 'Tyson', href: `${PX}/tyson.html`, image: '/images/events/tyson.webp', note: 'Conference programming for Tyson.' },
];

// The flagship leads its group full-width; the rest run as a two-up grid.
const [flagship, ...ownedRest] = owned;

const all = [...owned, ...forBrands];
const kindCount = (k: string) => all.filter((e) => e.kind.includes(k)).length;
const topics = [
  { label: 'Conference', count: kindCount('Conference') },
  { label: 'Expo', count: kindCount('Expo') },
  { label: 'Workshop', count: kindCount('Workshop') },
  { label: 'Community', count: kindCount('Community') },
];
---

<BaseLayout
  title="Events — SpoonAsia"
  description="The F&B events we run in Thailand — TRC, Restech, Damn Expo, CafCon, #LongKaek — and the conferences we produce for brands. Where operators, suppliers, and manufacturers meet."
>
  <SectionFront title="Events" topics={topics}>

    <div class="notice">
      <div class="notice-label">Produced by PenguinX</div>
      <p class="notice-text">
        The rooms where Thai F&B decisions get made — operators, suppliers,
        and manufacturers in one place. Five events we run ourselves, plus
        the conferences we produce for brands. Full programs, photo
        archives, and booking at
        <a href="https://penguinx.co/events.html" target="_blank" rel="noopener noreferrer">penguinx.co ↗</a>.
      </p>
    </div>

    <div class="group-head">Our events</div>

    <a href={flagship.href} target="_blank" rel="noopener noreferrer" class="ev-lead">
      <div class="ev-thumb wide">
        <img src={flagship.image} alt={flagship.name} width="960" height="640" loading="eager" />
      </div>
      <span class="kicker">{flagship.kind}</span>
      <h3 class="ev-head lead">{flagship.name} ↗</h3>
      <p class="dek">{flagship.note}</p>
    </a>

    <div class="ev-grid">
      {ownedRest.map((e) => (
        <a href={e.href} target="_blank" rel="noopener noreferrer" class="ev-card">
          <div class="ev-thumb">
            <img src={e.image} alt={e.name} width="960" height="640" loading="lazy" />
          </div>
          <span class="kicker">{e.kind}</span>
          <h3 class="ev-head">{e.name} ↗</h3>
          <p class="dek">{e.note}</p>
        </a>
      ))}
    </div>

    <div class="group-head">Produced for brands</div>
    <div class="ev-grid">
      {forBrands.map((e) => (
        <a href={e.href} target="_blank" rel="noopener noreferrer" class="ev-card">
          <div class="ev-thumb">
            <img src={e.image} alt={e.name} width="960" height="640" loading="lazy" />
          </div>
          <span class="kicker">{e.kind}</span>
          <h3 class="ev-head">{e.name} ↗</h3>
          <p class="dek">{e.note}</p>
        </a>
      ))}
    </div>

    <Fragment slot="rail">
      <RailSignup />
      <RailPromo section="events" />
    </Fragment>

  </SectionFront>
</BaseLayout>

<style>
  .group-head {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ink-soft);
    margin: 36px 0 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-hard, var(--ink));
  }

  .ev-lead,
  .ev-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ev-lead { margin-bottom: 32px; }

  .ev-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 32px;
    margin-bottom: 8px;
  }

  .ev-thumb {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--well, var(--paper-warm));
    margin-bottom: 12px;
  }

  .ev-thumb.wide { aspect-ratio: 21 / 9; }

  .ev-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .ev-lead:hover .ev-thumb img,
  .ev-card:hover .ev-thumb img {
    transform: scale(1.025);
  }

  .ev-head {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
    color: var(--ink);
    margin: 8px 0 0;
    transition: color 0.2s;
  }

  .ev-head.lead { font-size: 26px; }

  .ev-lead:hover .ev-head,
  .ev-card:hover .ev-head {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .ev-grid { grid-template-columns: 1fr; }
    .ev-thumb.wide { aspect-ratio: 3 / 2; }
  }
</style>
