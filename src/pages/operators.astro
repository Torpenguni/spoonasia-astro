---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionFront from '../components/SectionFront.astro';
import RailSignup from '../components/rail/RailSignup.astro';
import RailPromo from '../components/rail/RailPromo.astro';
import RailTopVideo from '../components/rail/RailTopVideo.astro';

const watchlist = [
  { tag: 'Chain', name: 'Penguin Eat Shabu', note: '40+ outlet shabu chain. Supplier consolidation as moat.' },
  { tag: 'Dessert', name: 'After You', note: 'Premium dessert format. Mall flagship economics.' },
  { tag: 'Forecourt', name: 'Inthanin', note: "Bangchak's coffee play. Forecourt-led footprint." },
  { tag: 'Scale', name: 'Caf\u00e9 Amazon', note: 'PTT-owned. 4,000+ outlets. The scale playbook nobody copies.' },
  { tag: 'Casual', name: 'Greyhound Caf\u00e9', note: 'Lifestyle-led casual dining. Mall-tier survivor.' },
];

const topics = watchlist.map((w) => ({ label: w.tag, count: 0 }));
---

<BaseLayout
  title="Operator Profiles — SpoonAsia"
  description="In-depth profiles of Thai F&B operators. Unit economics, growth playbooks, and the structural moats."
>
  <SectionFront title="Operator Stories" topics={topics}>

    <div class="notice">
      <div class="notice-label">In production</div>
      <p class="notice-text">
        The first five profiles are being researched — the operators are below.
        For early access when they publish, subscribe to <a href="/newsletter">The Dispatch</a>.
      </p>
    </div>

    <div class="watchlist">
      {watchlist.map((w) => (
        <article>
          <span class="kicker">{w.tag}</span>
          <h3>{w.name}</h3>
          <p class="dek">{w.note}</p>
        </article>
      ))}
    </div>

    <Fragment slot="rail">
      <RailSignup />
      <RailPromo section="operators" />
      <RailTopVideo />
    </Fragment>

  </SectionFront>
</BaseLayout>
