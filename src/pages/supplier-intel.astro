---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionFront from '../components/SectionFront.astro';
import RailSignup from '../components/rail/RailSignup.astro';
import RailPromo from '../components/rail/RailPromo.astro';
import RailMovers from '../components/rail/RailMovers.astro';

const watchlist = [
  { tag: 'Importers', name: 'The Thai specialty coffee duopoly', note: 'Two firms control 78% of single-origin bean flow. Volume share, origin breakdown, exclusive estate relationships.' },
  { tag: 'Distribution', name: 'Cold-chain operators serving Bangkok F&B', note: 'Who moves dairy, seafood, frozen proteins. Reliability scores by zone, capacity constraints, pricing transparency.' },
  { tag: 'Packaging', name: 'Sustainable F&B packaging \u2014 supply vs hype', note: 'PLA, sugarcane bagasse, mushroom mycelium \u2014 which are actually shipping at scale to Thai operators.' },
  { tag: 'Equipment', name: 'Kitchen equipment imports \u2014 Japan vs Italy vs Thai-made', note: 'Lead times, service network coverage, total cost of ownership across the three main supplier origins.' },
  { tag: 'Ingredients', name: 'Specialty wagyu and premium beef flow into Bangkok', note: 'Australian, Japanese, US import volumes. Mark-up structure from import point to restaurant kitchen.' },
];

const topics = watchlist.map((w) => ({ label: w.tag, count: 0 }));
---

<BaseLayout
  title="Supplier Intel — SpoonAsia"
  description="The hidden supply chains feeding Thailand's F&B economy — importers, distributors, equipment vendors, and the duopolies hiding in plain sight."
>
  <SectionFront title="Supplier Intel" topics={topics}>

    <div class="notice">
      <div class="notice-label">In production</div>
      <p class="notice-text">
        Supplier Intel launches Q3 2026 — the pipeline is below.
        Subscribe to <a href="/newsletter">The Dispatch</a> for supplier briefs as they publish.
      </p>
    </div>

    <div class="watchlist">
      {watchlist.map((w) => (
        <article>
          <span class="kicker">{w.tag}</span>
          <h3>{w.name}</h3>
          <p class="dek">{w.note}</p>
        </article>
      ))}
    </div>

    <Fragment slot="rail">
      <RailSignup />
      <RailPromo section="supplier-intel" />
      <RailMovers />
    </Fragment>

  </SectionFront>
</BaseLayout>
