---
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'Editorial',
    links: [
      { label: 'Analysis', href: '/analysis' },
      { label: 'Videos', href: '/videos' },
      { label: 'Market Watch', href: '/market-watch' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Penguin X', href: '/penguin-x' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Channels',
    links: [
      { label: 'YouTube', href: 'https://youtube.com/@spoonasia', external: true },
      { label: 'LinkedIn', href: 'https://linkedin.com/company/spoonasia', external: true },
      { label: 'Newsletter', href: '/newsletter' },
    ],
  },
];
---

<footer class="sa-footer">

  <div class="band">
    <div class="container">
      <div class="cols sa-newsletter">
        <div>
          <div class="section-tag sa-kicker">The Dispatch</div>
          <h2 class="sa-newsletter-head">F&B intelligence on Asia, every Sunday.</h2>
        </div>
        <div>
          <form class="sa-newsletter-form" onsubmit="event.preventDefault()">
            <input
              type="email"
              placeholder="your@email.com"
              class="sa-newsletter-input"
              aria-label="Email address"
              required
            />
            <button type="submit" class="sa-newsletter-submit">Subscribe</button>
          </form>
          <p class="sa-newsletter-note">
            Unit economics, neighborhood alpha, and the gaps in pitch decks. Read by
            operators across SG · JP · KR · UK · CN.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="band">
    <div class="container">
      <div class="cols sa-footer-main">
        <div class="sa-footer-brand">
          <div class="sa-logo">Spoon<span class="light">Asia</span><span class="dot" aria-hidden="true"></span></div>
          <p class="sa-footer-tagline">
            Decoding Thailand's F&B landscape for international investors, suppliers, and operators.
          </p>
          <div class="sa-footer-origin">A Torpenguin publication · Bangkok</div>
        </div>

        {footerSections.map(section => (
          <div class="sa-footer-col">
            <div class="sa-footer-col-title">{section.title}</div>
            <ul class="sa-footer-col-list">
              {section.links.map(link => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    class="sa-footer-link"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="container">
    <div class="sa-footer-ribbon">
      <div>© {currentYear} SpoonAsia · All rights reserved</div>
      <div class="sa-footer-ribbon-right">
        <a href="/privacy">Privacy</a>
        <span class="sep">·</span>
        <a href="/terms">Terms</a>
        <span class="sep">·</span>
        <a href="/colophon">Colophon</a>
      </div>
    </div>
  </div>

</footer>

<style>
  .sa-footer {
    border-top: 1px solid var(--rule-hard);
  }

  .sa-newsletter {
    grid-template-columns: 1fr 1fr;
    padding: 40px 0;
    align-items: start;
  }
  .sa-newsletter > *:first-child { padding-right: 40px; }
  .sa-newsletter > *:last-child { padding-left: 40px; }

  .sa-kicker { display: block; margin-bottom: 12px; }

  .sa-newsletter-head {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.028em;
    line-height: 1.1;
  }

  .sa-newsletter-form {
    display: flex;
    align-items: baseline;
    gap: 12px;
    border-bottom: 1px solid var(--rule-hard);
    padding-bottom: 8px;
  }

  .sa-newsletter-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--ink);
    padding: 4px 0;
  }
  .sa-newsletter-input::placeholder { color: var(--ink-mute); }
  .sa-newsletter-input:focus { outline: none; }

  .sa-newsletter-submit {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: transparent;
    border: none;
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }
  .sa-newsletter-submit:hover { color: var(--accent); }

  .sa-newsletter-note {
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-faint);
    margin-top: 14px;
    max-width: 46ch;
  }

  .sa-footer-main {
    grid-template-columns: 1.6fr repeat(3, 1fr);
    padding: 32px 0;
  }

  .sa-logo {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
  }
  .sa-logo .light { font-weight: 300; }
  .sa-logo .dot {
    display: inline-block;
    width: 3px;
    height: 3px;
    background: var(--accent);
    margin-left: 3px;
    align-self: flex-end;
    margin-bottom: 3px;
  }

  .sa-footer-tagline {
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 12px 0 14px;
    max-width: 44ch;
  }

  .sa-footer-origin {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .sa-footer-col-title {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 10px;
  }

  .sa-footer-col-list { list-style: none; }

  .sa-footer-link {
    display: block;
    font-size: 13px;
    color: var(--ink-soft);
    padding: 3px 0;
  }

  .sa-footer-ribbon {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0 24px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .sa-footer-ribbon-right {
    display: flex;
    gap: 8px;
  }

  .sa-footer-ribbon .sep { color: var(--rule); }

  @media (max-width: 900px) {
    .sa-newsletter > *:first-child { padding-right: 0; }
    .sa-newsletter > *:last-child { padding-left: 0; }
    .sa-footer-ribbon {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
