---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { properties } from '../../data/properties';

export async function getStaticPaths() {
  return properties.map((p) => ({ params: { slug: p.slug }, props: { property: p } }));
}

const { property: p } = Astro.props;
const others = properties.filter((o) => o.slug !== p.slug);
const slides = p.images && p.images.length > 0 ? p.images : [p.image];

// The standardized factsheet — same nine rows on every property.
const factsheet = [
  { label: 'Project', value: p.name },
  { label: 'Owner / Developer', value: p.owner },
  { label: 'Location', value: p.location },
  { label: 'Area', value: p.area },
  { label: 'Opening', value: p.openYear },
  { label: 'Anchor tenants', value: p.anchors },
  { label: 'The edge', value: p.highlight },
  { label: 'Customer base', value: p.customers },
  { label: 'Market tier', value: p.tier },
];
---

<BaseLayout
  title={`${p.name} — Property File — SpoonAsia`}
  description={p.read}
>
  <article class="file">
    <div class="container-narrow">

      <div class="crumbs">
        <a href="/locations">Locations</a>
        <span>/</span>
        <a href="/properties">Property Files</a>
      </div>

      <div class="section-tag">▍ Property File</div>
      <h1 class="file-h1">{p.name}</h1>
      <p class="file-dek">{p.read}</p>

      <div class="file-meta">
        <span class="meta-item">{p.district}</span>
        <span class="meta-dot">·</span>
        <span class="meta-item">{p.format}</span>
        <span class="meta-dot">·</span>
        <span class="meta-item status">{p.status}</span>
      </div>

      <figure class="file-hero">
        <div class="carousel">
          <div class="car-track" id="car-track">
            {slides.map((src) => (
              <div class="car-slide">
                <img src={src} alt={p.name} width="1600" height="900" loading="eager" />
              </div>
            ))}
          </div>
          {slides.length > 1 && (
            <>
              <button class="car-btn car-prev" aria-label="Previous photo">‹</button>
              <button class="car-btn car-next" aria-label="Next photo">›</button>
              <span class="car-count" id="car-count">1 / {slides.length}</span>
            </>
          )}
        </div>
        {(p.imageCredit || p.imageNote) && (
          <figcaption>
            {p.imageNote && <span>{p.imageNote} · </span>}
            {p.imageCredit && (
              p.imageCreditHref
                ? <a href={p.imageCreditHref} target="_blank" rel="noopener noreferrer">Photo: {p.imageCredit}</a>
                : <span>Photo: {p.imageCredit}</span>
            )}
            <span> · Full image credits in the site repository</span>
          </figcaption>
        )}
      </figure>

      <div class="facts">
        <div class="facts-head">Factsheet</div>
        <dl>
          {factsheet.map((f) => (
            <div class="fact-row">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      {p.sections.map((s) => (
        <section class="story">
          <h2 class="story-head">{s.head}</h2>
          {s.paragraphs.map((para) => <p class="story-para">{para}</p>)}
        </section>
      ))}

      <div class="cta">
        <div class="cta-label">Penguin X — Advisory</div>
        <p class="cta-text">
          Evaluating a lease in this project? Penguin X runs ground-truth due
          diligence for operators weighing Thai retail terms — catchment,
          effective rent, and the clauses that decide the P&L.
        </p>
        <a href="/penguin-x" class="cta-link">Request a briefing →</a>
      </div>

      <div class="more">
        <div class="more-head">More property files</div>
        <ul>
          {others.map((o) => (
            <li>
              <a href={`/properties/${o.slug}`}>{o.name}</a>
              <span class="more-status">{o.status}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </article>
</BaseLayout>

<style>
  .file { padding: 40px 0 80px; }

  .crumbs {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    display: flex;
    gap: 8px;
    margin-bottom: 28px;
  }

  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .crumbs a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  .section-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ink-soft);
    margin-bottom: 20px;
  }

  .file-h1 {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 44px;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 18px;
  }

  .file-dek {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 20px;
    max-width: 640px;
  }

  .file-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--rule-hard, var(--ink));
    margin-bottom: 26px;
  }

  .file-meta .status { color: var(--accent); }
  .meta-dot { color: var(--ink-faint); }

  .file-hero { margin: 0 0 8px; }

  .carousel { position: relative; }

  .car-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .car-track::-webkit-scrollbar { display: none; }

  .car-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .car-slide img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--paper-warm, var(--well));
  }

  .car-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border: none;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }

  .car-btn:hover { background: var(--accent); }
  .car-prev { left: 0; }
  .car-next { right: 0; }

  .car-count {
    position: absolute;
    right: 8px;
    bottom: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    padding: 3px 8px;
  }

  .file-hero figcaption {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: 6px;
  }

  .file-hero figcaption a { color: inherit; text-decoration: none; }
  .file-hero figcaption a:hover { color: var(--ink-soft); }

  .facts { margin: 34px 0 10px; }

  .facts-head,
  .story-head,
  .more-head {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--ink-soft);
    margin: 0 0 4px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-hard, var(--ink));
  }

  .facts dl { margin: 0; }

  .fact-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }

  .fact-row dt {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    padding-top: 3px;
  }

  .fact-row dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
  }

  .story { margin-top: 40px; }

  .story-para {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink);
    margin: 18px 0 0;
    max-width: 640px;
  }

  .cta {
    margin-top: 52px;
    background: var(--ink);
    padding: 32px 28px;
  }

  .cta-label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .cta-text {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.6;
    color: #b8b5ac;
    margin: 0 0 18px;
    max-width: 560px;
  }

  .cta-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 3px;
  }

  .cta-link:hover { color: var(--accent); }

  .more { margin-top: 48px; }

  .more ul { list-style: none; margin: 0; padding: 0; }

  .more li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }

  .more a {
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .more a:hover { color: var(--accent); }

  .more-status {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .file-h1 { font-size: 32px; }
    .fact-row { grid-template-columns: 1fr; gap: 4px; }
    .more li { flex-direction: column; gap: 4px; }
  }
</style>

<script>
  const track = document.getElementById('car-track');
  const count = document.getElementById('car-count');
  if (track) {
    const step = () => track.clientWidth;
    document.querySelector('.car-prev')?.addEventListener('click', () => {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    document.querySelector('.car-next')?.addEventListener('click', () => {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    if (count) {
      const total = track.children.length;
      track.addEventListener('scroll', () => {
        const i = Math.round(track.scrollLeft / step()) + 1;
        count.textContent = `${Math.min(Math.max(i, 1), total)} / ${total}`;
      }, { passive: true });
    }
  }
</script>
