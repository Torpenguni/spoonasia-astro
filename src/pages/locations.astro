---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionFront from '../components/SectionFront.astro';
import RailSignup from '../components/rail/RailSignup.astro';
import RailPromo from '../components/rail/RailPromo.astro';
import RailLatest from '../components/rail/RailLatest.astro';

const watchlist = [
  { tag: 'Premium CBD', name: 'Sukhumvit \u2014 Asoke / Thonglor / Ekkamai', note: 'Rent runs $78\u201395/sqm. Premium-mall saturation. Foreign-chain flagship belt. Margin compression risk: high.' },
  { tag: 'Creator Corridor', name: 'Ari', note: 'BTS Ari corridor. Independent-favored, low-rise zoning, creator-class footprint. Rent $42/sqm \u2014 rising fast.' },
  { tag: 'Frontier', name: 'Phra Khanong', note: 'Emerging F&B zone. Rents up 18% YoY. BTS upgrade Q4 2024. Window-of-entry open through 2026.' },
  { tag: 'Heritage', name: 'Charoenkrung / Talad Noi', note: "Heritage-led, slow burn. Premium-independent only. Mall-tier formats don't survive here." },
  { tag: 'Local-tier', name: 'Ratchada / Huai Khwang', note: 'Underwritten by night-market footfall. Resilient unit economics, lower ceiling.' },
  { tag: 'Mall-tier', name: 'EmQuartier / ICONSIAM / Central Embassy', note: 'Premium mall F&B vacancy at 7-year high. Effective rent down 15\u201322% vs 2024. Leverage window open.' },
];

const topics = watchlist.map((w) => ({ label: w.tag, count: 0 }));
---

<BaseLayout
  title="Locations — SpoonAsia"
  description="Bangkok F&B neighborhood intelligence. Rent curves, foot traffic, intent traffic, and the structural reads on where operators win or lose."
>
  <SectionFront title="Locations" topics={topics}>

    <div class="notice">
      <div class="notice-label">In production</div>
      <p class="notice-text">
        Locations launches Q3 2026 with monthly neighborhood reports.
        Subscribe to <a href="/newsletter">The Dispatch</a> for the first six zones.
      </p>
    </div>

    <div class="watchlist">
      {watchlist.map((w) => (
        <article>
          <span class="kicker">{w.tag}</span>
          <h3>{w.name}</h3>
          <p class="dek">{w.note}</p>
        </article>
      ))}
    </div>

    <Fragment slot="rail">
      <RailSignup />
      <RailPromo section="locations" />
      <RailLatest />
    </Fragment>

  </SectionFront>
</BaseLayout>
