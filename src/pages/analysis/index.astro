---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionFront from '../../components/SectionFront.astro';
import RailSignup from '../../components/rail/RailSignup.astro';
import RailPromo from '../../components/rail/RailPromo.astro';
import RailTopVideo from '../../components/rail/RailTopVideo.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/content';

const entries = await getCollection('articles', ({ data }) => !data.draft);
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const articles = entries.map((e) => ({
  slug: e.slug,
  title: e.data.title,
  dek: e.data.dek,
  category: e.data.category,
  tag: e.data.tag,
  author: e.data.author,
  date: fmt(e.data.date),
  readTime: e.data.readTime,
  minutes: parseInt(e.data.readTime, 10) || 0,
}));

// Beats run as a plain row. A beat with nothing in it still shows — the
// muted state is more honest than hiding the fact that we cover it.
const topics = categories
  .map((c) => ({
    label: c.label,
    href: `/analysis/${c.slug}`,
    count: articles.filter((a) => a.category === c.slug).length,
  }))
  .filter((t) => t.count > 0 || ['supplier-intel', 'market-entry'].includes(t.href.split('/').pop()!))
  .sort((a, b) => b.count - a.count);

// The flagship read is whichever piece runs longest — it earns the tint.
const longRead = [...articles].sort((a, b) => b.minutes - a.minutes)[0];
const feed = articles.filter((a) => a.slug !== longRead?.slug);

const [lead, second, third, fourth, ...rest] = feed;
const grid = rest.slice(0, 6);

const beatCards = categories
  .filter((c) => articles.some((a) => a.category === c.slug))
  .slice(0, 4);
---

<BaseLayout
  title="Market Analysis — SpoonAsia"
  description="Long-form F&B investment analysis for the Thailand market. Unit economics, neighborhood alpha, market entry, and supplier intel — 3,000–4,000 word reports."
>
  <SectionFront title="Market Analysis" topics={topics}>

    {lead && (
      <div class="hero">
        <article>
          <a href={`/analysis/${lead.slug}`}>
            <div class="well hero-well" aria-hidden="true"></div>
          </a>
          <span class="credit">{lead.author}</span>
          <span class="kicker">{lead.tag} · {lead.readTime}</span>
          <h2 class="hero-head"><a href={`/analysis/${lead.slug}`}>{lead.title}</a></h2>
          <p class="dek">{lead.dek}</p>
          <div class="meta">{lead.date}</div>
        </article>

        <div>
          {second && (
            <article>
              <a href={`/analysis/${second.slug}`}>
                <div class="well side-well" aria-hidden="true"></div>
              </a>
              <span class="kicker tight">{second.tag}</span>
              <h3 class="side-head"><a href={`/analysis/${second.slug}`}>{second.title}</a></h3>
            </article>
          )}
          <ul class="side-list">
            {[third, fourth].filter(Boolean).map((a) => (
              <li><h4><a href={`/analysis/${a.slug}`}>{a.title}</a></h4></li>
            ))}
          </ul>
        </div>
      </div>
    )}

    {longRead && (
      <div class="feature tinted">
        <div>
          <a href={`/analysis/${longRead.slug}`}>
            <div class="well feature-well" aria-hidden="true"></div>
          </a>
        </div>
        <div>
          <div class="feature-label">The Long Read</div>
          <h3 class="feature-head">
            <a href={`/analysis/${longRead.slug}`}>{longRead.title}</a>
          </h3>
          <p class="dek">{longRead.dek}</p>
          <div class="meta">{longRead.author} · {longRead.date} · {longRead.readTime}</div>
        </div>
      </div>
    )}

    {grid.length > 0 && (
      <div class="grid3">
        {grid.map((a) => (
          <article>
            <a href={`/analysis/${a.slug}`}>
              <div class="well grid-well" aria-hidden="true"></div>
            </a>
            <span class="kicker tight">{a.tag}</span>
            <h3><a href={`/analysis/${a.slug}`}>{a.title}</a></h3>
          </article>
        ))}
      </div>
    )}

    <Fragment slot="rail">
      <RailSignup />
      <RailPromo section="analysis" />
      <RailTopVideo />
    </Fragment>

    <div slot="full" class="band close">
      <div class="container">
        <div class="zone-label">Start with a beat</div>
        <div class="grid4">
          {beatCards.map((c) => (
            <article>
              <a href={`/analysis/${c.slug}`}>
                <div class="well grid-well" aria-hidden="true"></div>
              </a>
              <h3><a href={`/analysis/${c.slug}`}>{c.label}</a></h3>
              <p class="dek">{c.description.split('.')[0]}.</p>
            </article>
          ))}
        </div>
      </div>
    </div>

  </SectionFront>
</BaseLayout>
