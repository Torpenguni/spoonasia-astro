---
// A brand's logo, or a monogram plate until the logo file arrives.
import { logoFor, logoMeta, monogram } from '../../lib/brand-logos';

interface Props {
  id: string;
  name: string;
  size?: number;
  // fluid: fills its column as a 4:5 plate (section-front cards)
  fluid?: boolean;
}
const { id, name, size = 56, fluid = false } = Astro.props;
const src = logoFor(id);
const mono = monogram(name);
const m = src ? logoMeta(id) : undefined;
const cls = ['mark', src ? 'has-logo' : 'is-mono', m?.fit === 'fill' ? 'fill' : '', m?.bg === 'dark' ? 'dark' : '', fluid ? 'fluid' : ''].join(' ');
---

<span class={cls} style={`--s:${size}px`} aria-hidden="true">
  {src ? <img src={src} alt="" loading={fluid ? "eager" : "lazy"} decoding="async" /> : <span class={`mono len-${mono.length}`}>{mono}</span>}
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--s);
    height: var(--s);
    border: 1px solid var(--rule);
    background: var(--paper-pure);
    overflow: hidden;
  }
  .mark img { width: 80%; height: 80%; object-fit: contain; }
  .mark.fill img { width: 100%; height: 100%; object-fit: cover; }
  .mark.dark { background: #161514; border-color: #161514; }
  .is-mono { background: var(--well); }
  .mono {
    font-family: var(--font-sans);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--ink);
    opacity: 0.55;
    font-size: calc(var(--s) * 0.36);
    line-height: 1;
  }
  .mono.len-3 { font-size: calc(var(--s) * 0.28); }
  .mono.len-4 { font-size: calc(var(--s) * 0.22); }

  /* 5:4 plate that fills its card */
  .mark.fluid { width: 100%; height: auto; aspect-ratio: 5 / 4; container-type: inline-size; }
  .mark.fluid img { width: 76%; height: 72%; }
  .mark.fluid.fill img { width: auto; height: 100%; aspect-ratio: 1; object-fit: contain; }
  .mark.fluid .mono { font-size: 26cqw; }
  .mark.fluid .mono.len-3 { font-size: 20cqw; }
  .mark.fluid .mono.len-4 { font-size: 16cqw; }
</style>
