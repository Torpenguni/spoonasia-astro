---
import { loadTickers } from '../lib/tickers';
const { tickers, asOf, live } = await loadTickers();

// ~2.8s per quote keeps the scroll readable however many symbols we track.
const scrollSeconds = Math.max(60, Math.round(tickers.length * 2.8));
---

<div class="ticker-bar" data-ticker-bar>
  <div class="ticker-inner">
    <div class="ticker-label">F&B Markets</div>
    <div class="ticker-asof" data-ticker-asof title={live ? 'Live data via Yahoo Finance (SET delayed 15 min)' : 'Showing cached fallback'}>
      {live ? `AS OF ${asOf} ICT` : 'CACHED'}
    </div>
    <div class="ticker-track">
      <div class="ticker-content" data-ticker-content style={`animation-duration:${scrollSeconds}s`}>
        {tickers.map(t => (
          <div class="ticker-item">
            <span class="ticker-name">{t.label}</span>
            <span class="ticker-value">{t.value}</span>
            <span class={`ticker-change ${t.positive ? 'positive' : 'negative'}`}>
              {t.change}
            </span>
          </div>
        ))}
        {tickers.map(t => (
          <div class="ticker-item">
            <span class="ticker-name">{t.label}</span>
            <span class="ticker-value">{t.value}</span>
            <span class={`ticker-change ${t.positive ? 'positive' : 'negative'}`}>
              {t.change}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  // Client-side refresh: fetch /tickers.json every 60s so users keeping the
  // page open see fresh prices without a hard reload. The JSON is updated
  // every 15 min by .github/workflows/update-tickers.yml.
  type Ticker = { label: string; value: string; change: string; positive: boolean };
  type Payload = { tickers: Ticker[]; asOf: string; live: boolean };

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[c] as string));
  }

  function renderItems(tickers: Ticker[]): string {
    const oneSet = tickers.map(t => `
      <div class="ticker-item">
        <span class="ticker-name">${escapeHtml(t.label)}</span>
        <span class="ticker-value">${escapeHtml(t.value)}</span>
        <span class="ticker-change ${t.positive ? 'positive' : 'negative'}">${escapeHtml(t.change)}</span>
      </div>
    `).join('');
    return oneSet + oneSet; // duplicate for seamless scroll
  }

  async function refresh() {
    try {
      const res = await fetch('/tickers.json', { cache: 'no-store' });
      if (!res.ok) return;
      const data: Payload = await res.json();
      if (!data?.tickers?.length) return;

      const content = document.querySelector<HTMLElement>('[data-ticker-content]');
      const asOf = document.querySelector<HTMLElement>('[data-ticker-asof]');
      if (content) {
        content.innerHTML = renderItems(data.tickers);
        content.style.animationDuration = `${Math.max(60, Math.round(data.tickers.length * 2.8))}s`;
      }
      if (asOf) asOf.textContent = data.live ? `AS OF ${data.asOf} ICT` : 'CACHED';
    } catch {
      // Network error — silently keep current values
    }
  }

  refresh();
  setInterval(refresh, 60_000);
</script>

<style>
  /* Markets strip: white, 30px, each quote its own ruled cell — the data
     reads as data rather than as a banner. */
  .ticker-bar {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }

  .ticker-inner {
    display: flex;
    align-items: center;
    height: 30px;
    max-width: var(--plate);
    margin: 0 auto;
    padding-left: var(--gutter);
    border-left: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
  }

  .ticker-label {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    padding-right: 14px;
    border-right: 1px solid var(--rule);
  }

  .ticker-asof {
    flex-shrink: 0;
    padding: 0 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
    border-right: 1px solid var(--rule);
    cursor: help;
  }

  .ticker-track {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    position: relative;
  }

  .ticker-content {
    display: flex;
    gap: 0;
    animation: ticker-scroll 70s linear infinite; /* duration set inline from the quote count */
    white-space: nowrap;
    width: max-content;
  }

  @keyframes ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-content { animation: none; }
  }

  /* :global() — applied to client-side rendered items too */
  :global(.ticker-item) {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 0 18px;
    border-right: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  :global(.ticker-name) {
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.04em;
  }

  :global(.ticker-value) {
    color: var(--ink-soft);
  }

  :global(.ticker-change) {
    font-weight: 500;
  }

  :global(.ticker-change.positive) { color: var(--up); }
  :global(.ticker-change.negative) { color: var(--down); }

  @media (max-width: 768px) {
    .ticker-inner {
      padding-left: var(--gutter);
      border-left: none;
      border-right: none;
    }
    .ticker-label { font-size: 9px; padding-right: 10px; }
    .ticker-asof { display: none; }
    :global(.ticker-item) { padding: 0 14px; font-size: 10px; }
  }
</style>
