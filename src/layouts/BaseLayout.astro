---
import '../styles/global.css';
import Ribbon from '../components/Ribbon.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { defaultLang } from '../i18n/ui';
import { getAlternates, getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const htmlLang = lang === 'ja' ? 'ja' : 'en';
const ogLocale = { en: 'en_US', ja: 'ja_JP' }[lang];

const site = Astro.site ?? new URL('https://spoonasia.com');
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, site).href;

// hreflang is only emitted when the page actually has another language
// edition; a lone English page gets no alternates.
const alternates = getAlternates(Astro.url.pathname);
const hasAlternates = alternates.length > 1;
const xDefault = alternates.find((a) => a.lang === defaultLang)!;
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {hasAlternates && alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.lang} href={new URL(alt.path, site).href} />
  ))}
  {hasAlternates && (
    <link rel="alternate" hreflang="x-default" href={new URL(xDefault.path, site).href} />
  )}

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="SpoonAsia" />
  <meta property="og:locale" content={ogLocale} />
  {hasAlternates && alternates.filter((a) => a.lang !== lang).map((alt) => (
    <meta property="og:locale:alternate" content={{ en: 'en_US', ja: 'ja_JP' }[alt.lang]} />
  ))}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  {lang === 'ja' && (
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;600&display=swap" rel="stylesheet">
  )}

  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
</head>
<body>
  <!-- The markets strip runs full bleed; the plate frame opens below it. -->
  <Ribbon />
  <div class="page-frame">
    <Nav />
    <slot />
    <Footer />
  </div>
</body>
</html>
