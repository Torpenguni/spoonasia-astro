---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionFront from '../components/SectionFront.astro';
import RailSignup from '../components/rail/RailSignup.astro';
import RailPromo from '../components/rail/RailPromo.astro';
import RailMovers from '../components/rail/RailMovers.astro';

const watchlist = [
  { tag: 'Acquisition', name: 'Minor International eyes regional shabu category', note: 'Quiet diligence on at least two operators. Q3 2026 close target rumored.' },
  { tag: 'Fundraise', name: 'Bangkok specialty coffee chain in Series B talks', note: '$8\u201312M round. Singapore family office and a Japanese strategic on the cap table.' },
  { tag: 'Exit', name: 'PE-backed bubble tea brand testing strategic buyers', note: 'Eight-year hold. Returns capped by post-2024 margin compression.' },
  { tag: 'Joint Venture', name: 'Japanese udon chain \u00d7 Thai mall operator', note: 'Master franchise structure under construction. Three flagship slots.' },
];

const topics = watchlist.map((w) => ({ label: w.tag, count: 0 }));
---

<BaseLayout
  title="M&A & Deals — SpoonAsia"
  description="Thai F&B deal flow: acquisitions, fundraises, exits, joint ventures, and the structural shifts behind them."
>
  <SectionFront title="M&A & Deals" topics={topics}>

    <div class="notice">
      <div class="notice-label">In production</div>
      <p class="notice-text">
        Deal coverage launches Q3 2026. Below is what is currently on our watchlist.
        For alerts when it goes live, subscribe to <a href="/newsletter">The Dispatch</a>.
      </p>
    </div>

    <div class="watchlist">
      {watchlist.map((w) => (
        <article>
          <span class="kicker">{w.tag}</span>
          <h3>{w.name}</h3>
          <p class="dek">{w.note}</p>
        </article>
      ))}
    </div>

    <Fragment slot="rail">
      <RailSignup />
      <RailPromo section="deals" />
      <RailMovers />
    </Fragment>

  </SectionFront>
</BaseLayout>
