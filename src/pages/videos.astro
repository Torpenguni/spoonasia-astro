---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionFront from '../components/SectionFront.astro';
import RailSignup from '../components/rail/RailSignup.astro';
import RailPromo from '../components/rail/RailPromo.astro';
import RailLatest from '../components/rail/RailLatest.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('videos', ({ data }) => !data.draft);
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const videos = entries.map((e) => ({
  slug: e.slug,
  episode: e.data.episode,
  title: e.data.title,
  description: e.data.description,
  duration: e.data.duration,
  views: e.data.views,
  date: fmt(e.data.date),
}));

const [lead] = videos;

const channels = [
  { label: 'Operator Stories', href: '/videos/operators', blurb: 'Inside the P&L, told by the people running it.' },
  { label: 'Walking Tours', href: '/videos/walking-tours', blurb: 'Reading a street the way an operator reads a lease.' },
  { label: 'Torpenguin', href: '/videos/torpenguin', blurb: 'The founder channel, in long form.' },
  { label: 'Founder Stories', href: '/videos/founder-stories', blurb: 'Opening soon.' },
];

const topics = [
  { label: 'All Episodes', href: '/videos' },
  { label: 'Operator Stories', href: '/videos/operators' },
  { label: 'Walking Tours', href: '/videos/walking-tours' },
  { label: 'Torpenguin', href: '/videos/torpenguin' },
  { label: 'Founder Stories', href: '/videos/founder-stories', count: 0 },
  { label: 'Restaurant Tech', href: '/videos/restaurant-tech', count: 0 },
];
---

<BaseLayout
  title="Videos — SpoonAsia"
  description="Long-form breakdowns of brands, neighborhoods, and unit economics. New episode every Tuesday."
>
  <SectionFront title="Videos" topics={topics} activeTopic="All Episodes">

    {lead && (
      <div class="vid-hero">
        <a href={`/videos/${lead.slug}`}>
          <div class="well vid-hero-well" aria-hidden="true">
            <span class="play lg">▶</span>
            <span class="dur">{lead.duration}</span>
          </div>
        </a>
        <span class="kicker">Ep. {lead.episode} · {lead.views} views</span>
        <h2 class="hero-head"><a href={`/videos/${lead.slug}`}>{lead.title}</a></h2>
        <p class="dek">{lead.description}</p>
        <div class="meta">{lead.date} · {lead.duration}</div>
      </div>
    )}

    {videos.length > 0 && (
      <div class="grid3">
        {videos.map((v) => (
          <article>
            <a href={`/videos/${v.slug}`}>
              <div class="well grid-well vid-cell" aria-hidden="true">
                <span class="play sm">▶</span>
                <span class="dur">{v.duration}</span>
              </div>
            </a>
            <span class="kicker tight">Ep. {v.episode} · {v.views} views</span>
            <h3><a href={`/videos/${v.slug}`}>{v.title}</a></h3>
          </article>
        ))}
      </div>
    )}

    <Fragment slot="rail">
      <RailSignup />
      <RailPromo section="videos" />
      <RailLatest />
    </Fragment>

    <div slot="full" class="band close">
      <div class="container">
        <div class="zone-label">Channels</div>
        <div class="grid4">
          {channels.map((c) => (
            <article>
              <a href={c.href}>
                <div class="well grid-well" aria-hidden="true"></div>
              </a>
              <h3><a href={c.href}>{c.label}</a></h3>
              <p class="dek">{c.blurb}</p>
            </article>
          ))}
        </div>
      </div>
    </div>

  </SectionFront>
</BaseLayout>

<style>
  .vid-hero { padding: 26px 0 28px; }

  .vid-hero-well {
    aspect-ratio: 16 / 9;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .vid-cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
